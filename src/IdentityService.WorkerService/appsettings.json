{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Extensions.Http": "Warning"
    }
  },
  "Wolverine": {
    "SagaTimeout": {
      "Development": "00:05:00",
      "Staging": "00:10:00",
      "Production": "00:15:00"
    }
  },
  "KeycloakRetry": {
    "MaxRetries": 3,
    "InitialDelayMs": 100,
    "MaxDelayMs": 2000,
    "BackoffMultiplier": 2.0
  },
  "Prometheus": {
    "Enabled": true,
    "Port": 9090,
    "Url": "/metrics"
  },
  "Keycloak": {
    "Url": "http://localhost:8080",
    "Realm": "mif",
    "ClientId": "identity-service",
    "ClientSecret": ""
  },
  "MongoDB": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "mif_identity_cache"
  }
}
